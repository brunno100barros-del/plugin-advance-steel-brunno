<?xml version="1.0" encoding="utf-8"?>
<!-- Fonte de pacotes só deste repositório (a xBIM vem do nuget.org oficial). Não altera a configuração global do NuGet. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
