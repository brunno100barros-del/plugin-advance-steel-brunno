<Project>
  <!-- Configuração comum aos projetos em src/. -->
  <PropertyGroup>
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2027</AcadDir>
    <AdvsDir>$(AcadDir)\ADVS</AdvsDir>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>0.10.0</Version>
    <Authors>Brunno Barros</Authors>
    <Product>Plugin Advance Steel - Brunno</Product>
    <!-- Não gravar caminhos da máquina de quem compila nas DLLs publicadas (repositório público). -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/pasb/$(MSBuildProjectName)</PathMap>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
